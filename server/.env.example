PORT=8787
DB_PATH=./data/power.sqlite
CACHE_SECONDS=600
POLL_CONCURRENCY=3
SCHOOL_MAX_CONCURRENCY=3
SCHOOL_TIMEOUT_MS=10000
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_QUERY_PER_MINUTE=12
# Optional: protect requests to the Expo Push service when the project requires it.
EXPO_ACCESS_TOKEN=
# Required for the release script that publishes an APK update and broadcasts it.
MOBILE_UPDATE_ADMIN_TOKEN=
TRUST_PROXY=1
