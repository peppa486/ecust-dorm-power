.about-page {
  padding-top: 54rpx;
}

.about-head {
  padding: 18rpx 10rpx 34rpx;
}

.about-title,
.about-subtitle {
  display: block;
}

.about-title {
  font-size: 52rpx;
  font-weight: 760;
  letter-spacing: -3rpx;
}

.about-subtitle {
  margin-top: 12rpx;
  color: #a0a5ad;
  font-size: 22rpx;
  letter-spacing: 1rpx;
}

.about-card {
  padding: 8rpx 28rpx;
}

.about-row {
  display: flex;
  gap: 16rpx;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #eff0f2;
}

.about-row:last-child {
  border-bottom: 0;
}

.about-label {
  width: 110rpx;
  flex-shrink: 0;
  color: #777d85;
  font-size: 25rpx;
  font-weight: 650;
}

.about-text {
  flex: 1;
  min-width: 0;
  color: #35383d;
  font-size: 25rpx;
  line-height: 1.7;
}

.about-foot {
  display: block;
  margin-top: 30rpx;
  color: #afb3ba;
  font-size: 21rpx;
  text-align: center;
}
