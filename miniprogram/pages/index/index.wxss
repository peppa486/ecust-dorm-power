.index-page {
  padding-top: 24rpx;
}

.hero {
  padding: 26rpx 10rpx 28rpx;
}

.brand-line {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.brand {
  font-size: 54rpx;
  line-height: 1;
  font-weight: 760;
  letter-spacing: -3rpx;
}

.query-card,
.result-card,
.reminder-card {
  padding: 28rpx;
  margin-bottom: 22rpx;
}

.segmented {
  display: flex;
  padding: 6rpx;
  border-radius: 19rpx;
  background: #f0f1f3;
}

.segment {
  flex: 1;
  padding: 18rpx 0;
  border-radius: 15rpx;
  color: #8b9098;
  font-size: 27rpx;
  font-weight: 600;
  text-align: center;
}

.segment-active {
  background: #fff;
  color: #1c1f24;
  box-shadow: 0 3rpx 12rpx rgba(22, 26, 32, 0.07);
}

.field-grid {
  display: flex;
  gap: 18rpx;
  margin-top: 26rpx;
}

.field-block {
  flex: 1;
  min-width: 0;
}

.field-label {
  display: block;
  margin: 0 0 10rpx 4rpx;
  color: #999ea6;
  font-size: 23rpx;
}

.field-value,
.room-input {
  box-sizing: border-box;
  width: 100%;
  height: 88rpx;
  padding: 0 22rpx;
  border-radius: 18rpx;
  background: #f5f6f7;
  color: #24272b;
  font-size: 29rpx;
  line-height: 88rpx;
}

.field-value {
  display: flex;
  align-items: center;
  justify-content: space-between;
  white-space: nowrap;
  overflow: hidden;
}

.chevron {
  margin-left: 8rpx;
  color: #a0a5ad;
  font-size: 30rpx;
}

.primary-btn,
.soft-btn,
.text-btn {
  box-sizing: border-box;
  min-height: 82rpx;
  border-radius: 18rpx;
  font-size: 28rpx;
  font-weight: 650;
}

.primary-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  margin-top: 26rpx;
  background: #1c1f24;
  color: #fff;
}

.primary-btn[disabled] {
  background: #5c6066;
  color: #fff;
}

.soft-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  background: #f0f1f3;
  color: #24272b;
}

.text-btn {
  width: 120rpx;
  background: transparent;
  color: #9a9fa7;
}

.result-top,
.section-head,
.result-actions,
.reminder-actions {
  display: flex;
  align-items: center;
}

.result-top,
.section-head {
  justify-content: space-between;
  gap: 22rpx;
}

.result-caption,
.section-subtitle {
  display: block;
  color: #9a9fa7;
  font-size: 23rpx;
}

.power-value {
  margin-top: 8rpx;
  font-size: 88rpx;
  line-height: 1.05;
  font-weight: 760;
  letter-spacing: -5rpx;
}

.power-unit {
  margin-left: 10rpx;
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 0;
}

.status-pill {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 12rpx 16rpx;
  border-radius: 999rpx;
  font-size: 23rpx;
  font-weight: 600;
}

.status-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: currentColor;
}

.status-good {
  background: #edf7f1;
  color: #2f7650;
}

.status-warning {
  background: #fff5e4;
  color: #91620e;
}

.status-danger {
  background: #fff0ef;
  color: #a7433b;
}

.result-meta {
  margin-top: 22rpx;
  color: #92979f;
  font-size: 24rpx;
}

.result-actions {
  gap: 10rpx;
  margin-top: 26rpx;
}

.section-title {
  display: block;
  font-size: 31rpx;
  font-weight: 700;
}

.section-subtitle {
  margin-top: 8rpx;
}

.threshold-number {
  font-size: 38rpx;
  font-weight: 700;
}

.threshold-unit {
  color: #8f949d;
  font-size: 22rpx;
  font-weight: 500;
}

.reminder-card slider {
  margin: 24rpx 0 22rpx;
}

.reminder-actions {
  gap: 14rpx;
}

.reminder-actions .primary-btn,
.reminder-actions .soft-btn {
  flex: 1;
  margin-top: 0;
}

.primary-btn.small {
  min-height: 82rpx;
}

.footer {
  display: flex;
  justify-content: space-between;
  padding: 18rpx 10rpx 0;
  color: #a6abb2;
  font-size: 22rpx;
}

.footer-link {
  color: #6f747c;
}
