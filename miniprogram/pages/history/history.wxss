.history-page {
  padding-top: 34rpx;
}

.history-head {
  padding: 12rpx 10rpx 28rpx;
}

.history-title {
  display: block;
  font-size: 46rpx;
  font-weight: 760;
  letter-spacing: -2rpx;
}

.history-room {
  display: block;
  margin-top: 11rpx;
  color: #9398a0;
  font-size: 24rpx;
}

.current-card,
.chart-card,
.records-card,
.empty-card {
  margin-bottom: 22rpx;
  padding: 28rpx;
}

.current-label {
  color: #9a9fa7;
  font-size: 23rpx;
}

.current-value {
  margin-top: 7rpx;
  font-size: 76rpx;
  line-height: 1.1;
  font-weight: 760;
  letter-spacing: -4rpx;
}

.current-unit {
  font-size: 27rpx;
  font-weight: 600;
  letter-spacing: 0;
}

.stats-grid {
  display: flex;
  gap: 10rpx;
  margin-top: 30rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #eef0f2;
}

.stat {
  flex: 1;
  min-width: 0;
}

.stat-value,
.stat-label {
  display: block;
}

.stat-value {
  color: #2c2f34;
  font-size: 27rpx;
  font-weight: 650;
}

.stat-label {
  margin-top: 7rpx;
  color: #a0a5ad;
  font-size: 21rpx;
}

.chart-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.chart-title {
  font-size: 29rpx;
  font-weight: 700;
}

.chart-caption {
  color: #a0a5ad;
  font-size: 21rpx;
}

.trend-canvas {
  display: block;
  width: 100%;
  height: 260rpx;
  margin-top: 24rpx;
}

.empty-card {
  color: #969ba3;
  font-size: 25rpx;
  text-align: center;
}

.record {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 72rpx;
  border-bottom: 1rpx solid #f0f1f3;
}

.record:last-child {
  border-bottom: 0;
}

.record-time {
  color: #969ba3;
  font-size: 23rpx;
}

.record-value {
  color: #292c30;
  font-size: 25rpx;
  font-weight: 650;
}
