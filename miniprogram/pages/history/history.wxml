<view class="page history-page">
  <view class="history-head">
    <text class="history-title">用电趋势</text>
    <text class="history-room">{{roomName}}</text>
  </view>

  <view class="surface current-card" wx:if="{{stats}}">
    <text class="current-label">当前</text>
    <view class="current-value">{{currentNumber}}<text class="current-unit" wx:if="{{hasCurrent}}"> 度</text></view>
    <view class="stats-grid">
      <view class="stat" wx:for="{{statCards}}" wx:key="label">
        <text class="stat-value">{{item.value}}</text>
        <text class="stat-label">{{item.label}}</text>
      </view>
    </view>
  </view>

  <view class="surface chart-card" wx:if="{{chartReady}}">
    <view class="chart-head">
      <text class="chart-title">近7天</text>
    </view>
    <canvas type="2d" id="trendCanvas" class="trend-canvas"></canvas>
  </view>

  <view class="surface empty-card" wx:elif="{{!loading}}">
    <text>数据还在积累</text>
  </view>

  <view class="surface records-card" wx:if="{{recent.length}}">
    <view class="record" wx:for="{{recent}}" wx:key="id">
      <text class="record-time">{{item.time}}</text>
      <text class="record-value">{{item.kwh}} 度</text>
    </view>
  </view>
</view>
