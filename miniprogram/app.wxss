page {
  min-height: 100%;
  background: #f4f5f7;
  color: #17191c;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

button {
  margin: 0;
  padding: 0;
  line-height: 1;
}

button::after {
  border: 0;
}

.page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 34rpx 28rpx 54rpx;
}

.surface {
  background: #ffffff;
  border: 1rpx solid rgba(20, 24, 32, 0.05);
  border-radius: 30rpx;
}

.muted {
  color: #8b919a;
}

.tap {
  transition: opacity 120ms ease;
}

.tap:active {
  opacity: 0.68;
}
